# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# required for non-vercel deployments, vercel uses OIDC automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****

# MCP servers exposed to the LLM as tools.
# Format: comma-separated `name=url` (preferred) or just URLs (auto-named).
# Both legacy SSE and modern Streamable HTTP transports are auto-detected.
# Examples:
#   MCP_SERVERS=pizzaz=http://localhost:8000/mcp,solar=http://localhost:8001/mcp
#   MCP_SERVERS=http://localhost:8000/mcp
# `MCP_PIZZAZ_URL` (legacy single-server) is still honored when MCP_SERVERS is unset.
MCP_SERVERS=pizzaz=http://localhost:8000/mcp,solar=http://localhost:8001/mcp



OPENAI_API_KEY=****
