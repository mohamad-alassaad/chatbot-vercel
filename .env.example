# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# required for non-vercel deployments, vercel uses OIDC automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****

# Pizzaz MCP server (POC). Run via:
#   cd openai-apps-sdk-examples && pnpm run serve  (asset host on :4444)
#   cd openai-apps-sdk-examples/pizzaz_server_node && pnpm start  (MCP on :8000)
MCP_PIZZAZ_URL=http://localhost:8000/mcp



OPENAI_API_KEY=****
